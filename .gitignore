# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# NOTE: rules are intentionally unanchored (no leading slash) because this repo
# contains two sub-projects (React app + Python server) whose outputs live in
# subdirectories, not at the repository root.

# dependencies
node_modules/
.pnp
.pnp.js

# testing
coverage/

# production
build/

# misc
.DS_Store
Thumbs.db
desktop.ini
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# python
__pycache__/
*.py[cod]
.venv/
venv/

# dataset (Indian Liver Patient Records, via Kaggle - see README)
indian_liver_patient.csv

# runtime-generated training artifacts (regenerated by main.py on retrain)
metrics.txt
untrained_model.pl
